# 复制本文件为 .env 后填入 Key。配置优先级：界面选择 > 环境变量 > 默认值。

# ---- 必填 ----
HY3_API_KEY=sk-xxx                                  # 也可写 OPENAI_API_KEY

# ---- 可选：端点与模型 ----
HY3_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
HY3_MODEL=hy3                                       # 也支持 hy4-preview / glm-* / kimi-* / deepseek-* 等

# ---- 可选：思考强度 ----
# auto（跟随模型默认，缺省值）| off（最快）| low | medium | high
# 兼容旧写法：disabled == off，enabled == auto
HY3_THINKING=off

# ---- 可选：稳定性与并发 ----
LLM_TIMEOUT=600                                     # 单轮超时（秒）；开启深度思考时建议 >= 600
LLM_MAX_RETRIES=5                                   # 429 / 5xx 指数退避重试次数
CRITIC_PARALLELISM=5                                # Critic 五段并行的并发数
