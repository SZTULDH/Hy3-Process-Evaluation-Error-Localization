{"id":"easy-007","difficulty":"easy","title":"绝对值","description":"返回整数 x 的绝对值。","function_signature":"def abs_val(x: int) -> int","entry_point":"abs_val","constraints":"-10^9 <= x <= 10^9","expected_complexity":{"time":"O(1)","space":"O(1)"},"required_edge_cases":["负数","零"],"public_tests":[{"args":[5],"expected":5},{"args":[-3],"expected":3},{"args":[0],"expected":0}],"adversarial_tests":[{"args":[-1],"expected":1},{"args":[1000000000],"expected":1000000000}],"mock_solution":{"解题思路":"若 x < 0 返回 -x。","复杂度分析":"时间 O(1)，空间 O(1)。","关键边界与处理策略":"零返回 0。","代码实现":"```python\ndef abs_val(x: int) -> int:\n    return -x if x < 0 else x\n```","自测说明":"公开用例通过。"},"ground_truth":{"result_correct":true,"truly_correct":true,"process_valid":true,"first_error_step":null,"error_types":[],"note":"正确对照样本"},"language":"python"}