{"id":"adversarial-003","difficulty":"adversarial","title":"缺失的数字（伪正确）","description":"给定包含 0 到 n 中 n 个数的数组，找出缺失的那个数。","function_signature":"def missing_number(nums: list) -> int","entry_point":"missing_number","language":"python","constraints":"n == len(nums)","expected_complexity":{"time":"O(n)","space":"O(1)"},"required_edge_cases":["缺0","缺n","缺中间"],"public_tests":[{"args":[[3,0,1]],"expected":2},{"args":[[0,1,2,4]],"expected":3},{"args":[[1]],"expected":0}],"adversarial_tests":[{"args":[[0,1]],"expected":2},{"args":[[1,2]],"expected":0},{"args":[[0]],"expected":1}],"mock_solution":{"解题思路":"用 max 代替 n。","复杂度分析":"时间 O(n)，空间 O(1)。","关键边界与处理策略":"讨论含 0 情况。","代码实现":"```python\ndef missing_number(nums: list) -> int:\n    m = max(nums) if nums else 0\n    return m * (m + 1) // 2 - sum(nums)\n```","自测说明":"公开用例通过。"},"ground_truth":{"result_correct":true,"truly_correct":false,"process_valid":false,"first_error_step":"step_3_edge_cases","error_types":["实现逻辑缺陷","测试覆盖不足导致的伪正确"],"note":"用 max 代替 n：缺失值为 n 时失败"}}