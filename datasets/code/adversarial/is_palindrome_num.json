{"id":"adversarial-005","difficulty":"adversarial","title":"回文数（转字符串）","description":"判断整数 x 是否为回文数。要求不使用字符串转换。","function_signature":"def is_palindrome_num(x: int) -> bool","entry_point":"is_palindrome_num","constraints":"-2^31 <= x <= 2^31 - 1","expected_complexity":{"time":"O(log |x|)","space":"O(1)"},"required_edge_cases":["负数","末尾0"],"public_tests":[{"args":[121],"expected":true},{"args":[-121],"expected":false},{"args":[10],"expected":false}],"adversarial_tests":[{"args":[0],"expected":true},{"args":[12321],"expected":true}],"mock_solution":{"解题思路":"转成字符串再判断。","复杂度分析":"时间 O(log |x|)，空间 O(1)。","关键边界与处理策略":"负数不是回文。","代码实现":"```python\ndef is_palindrome_num(x: int) -> bool:\n    s = str(x)\n    return s == s[::-1]\n```","自测说明":"公开用例通过。"},"ground_truth":{"result_correct":true,"truly_correct":true,"process_valid":false,"first_error_step":"step_1_approach","error_types":["算法选择错误","复杂度分析错误"],"note":"违反不用字符串约束"},"language":"python"}